# Zairenkai balanced tweaks - Linux 5.10 GKI (validated on gki_defconfig).
# GKI rule: the stock vendor_dlkm modules must keep loading, so only options
# that add built-in code without changing exported symbols or struct layouts
# (KMI) are allowed here. No HZ, scheduler, or memory-model changes.
CONFIG_TCP_CONG_ADVANCED=y
CONFIG_TCP_CONG_BBR=y
CONFIG_DEFAULT_BBR=y
# CONFIG_DEFAULT_CUBIC is not set
