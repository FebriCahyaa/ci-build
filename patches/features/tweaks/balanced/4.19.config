# Zairenkai balanced tweaks - Linux 4.19 non-GKI (validated on sdm660 + lavender.config).
# TCP: BBR with fair-queue pacing improves throughput/latency on mobile links.
CONFIG_TCP_CONG_ADVANCED=y
CONFIG_TCP_CONG_BBR=y
CONFIG_DEFAULT_BBR=y
# CONFIG_DEFAULT_CUBIC is not set
CONFIG_NET_SCH_FQ=y
CONFIG_NET_SCH_DEFAULT=y
CONFIG_DEFAULT_FQ=y
# CONFIG_DEFAULT_PFIFO_FAST is not set
# zram: LZ4 favours (de)compression speed over lzo-rle's ratio.
CONFIG_CRYPTO_LZ4=y
CONFIG_ZRAM_DEF_COMP_LZ4=y
# CONFIG_ZRAM_DEF_COMP_LZORLE is not set
