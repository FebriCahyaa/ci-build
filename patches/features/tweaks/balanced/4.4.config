# Zairenkai balanced tweaks - Linux 4.4 non-GKI (validated on lavender_defconfig).
# TCP: Westwood+ recovers faster than CUBIC on lossy mobile links.
# (BBR is not available in this kernel generation.)
CONFIG_TCP_CONG_ADVANCED=y
CONFIG_TCP_CONG_WESTWOOD=y
CONFIG_DEFAULT_WESTWOOD=y
# CONFIG_DEFAULT_CUBIC is not set
CONFIG_NET_SCH_FQ=y
# Block: deadline gives lower, more predictable latency than CFQ on eMMC/UFS.
CONFIG_IOSCHED_DEADLINE=y
CONFIG_DEFAULT_DEADLINE=y
# CONFIG_DEFAULT_CFQ is not set
# zram: LZ4 favours (de)compression speed over ratio.
CONFIG_ZRAM=y
CONFIG_CRYPTO_LZ4=y
