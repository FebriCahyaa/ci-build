diff --git a/kernel/compat/linux-4.4/ksu_compat_44.h b/kernel/compat/linux-4.4/ksu_compat_44.h
new file mode 100644
index 00000000..927f321a
--- /dev/null
+++ b/kernel/compat/linux-4.4/ksu_compat_44.h
@@ -0,0 +1,52 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * Linux 4.4 compatibility for the KernelSU-Next legacy driver.
+ * Force-included into every driver object by Kbuild on kernels < 4.11 only.
+ */
+#ifndef __KSU_COMPAT_44_H
+#define __KSU_COMPAT_44_H
+
+#include <linux/version.h>
+#include <linux/kernel.h>
+#include <linux/compiler.h>
+
+/* 4.16: ALIGN_DOWN() */
+#ifndef ALIGN_DOWN
+#define ALIGN_DOWN(x, a) __ALIGN_KERNEL((x) - ((a) - 1), (a))
+#endif
+
+/* 4.6: in_compat_syscall() */
+#if LINUX_VERSION_CODE < KERNEL_VERSION(4, 6, 0)
+#include <linux/compat.h>
+#ifndef in_compat_syscall
+static inline bool in_compat_syscall(void)
+{
+#ifdef CONFIG_COMPAT
+	return is_compat_task();
+#else
+	return false;
+#endif
+}
+#endif
+#endif
+
+/* 4.12: kvmalloc() (kvfree() exists since 3.15) */
+#if LINUX_VERSION_CODE < KERNEL_VERSION(4, 12, 0)
+#include <linux/slab.h>
+#include <linux/vmalloc.h>
+static inline void *kvmalloc(size_t size, gfp_t flags)
+{
+	void *p = kmalloc(size, flags | __GFP_NOWARN);
+
+	if (p)
+		return p;
+	return (flags & __GFP_ZERO) ? vzalloc(size) : vmalloc(size);
+}
+#endif
+
+/* 4.17 / 5.x: CFI annotation; 4.4 has no Clang CFI. */
+#ifndef __nocfi
+#define __nocfi
+#endif
+
+#endif /* __KSU_COMPAT_44_H */
