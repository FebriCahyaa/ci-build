Subject: [PATCH] vfs/seccomp/selinux: backports for KernelSU-Next legacy (Linux 4.4)

* fs/namespace.c, fs/internal.h: path_umount()/can_umount() (Linux 5.9,
  41525f56e256), used to unmount module mounts for denylisted apps.
* include/linux/seccomp.h: atomic_t filter_count (Linux 5.9).
* security/selinux/include/objsec.h: selinux_cred()/selinux_inode()
  LSM-blob accessors (Linux 5.1).
---
diff --git a/fs/internal.h b/fs/internal.h
index 0ec68117..788e4a0b 100644
--- a/fs/internal.h
+++ b/fs/internal.h
@@ -64,6 +64,7 @@ extern int finish_automount(struct vfsmount *, struct path *);
 extern int sb_prepare_remount_readonly(struct super_block *);
 
 extern void __init mnt_init(void);
+int path_umount(struct path *path, int flags);
 
 extern int __mnt_want_write(struct vfsmount *);
 extern int __mnt_want_write_file(struct file *);
diff --git a/fs/namespace.c b/fs/namespace.c
index 2443cdb9..693c3b6f 100644
--- a/fs/namespace.c
+++ b/fs/namespace.c
@@ -1734,6 +1734,44 @@ SYSCALL_DEFINE1(oldumount, char __user *, name)
 
 #endif
 
+/*
+ * Backport of the Linux 5.9 path_umount() helper (commit 41525f56e256),
+ * used by KernelSU to unmount module overlays for denylisted apps.
+ */
+static int can_umount(const struct path *path, int flags)
+{
+	struct mount *mnt = real_mount(path->mnt);
+
+	if (flags & ~(MNT_FORCE | MNT_DETACH | MNT_EXPIRE | UMOUNT_NOFOLLOW))
+		return -EINVAL;
+	if (!may_mount())
+		return -EPERM;
+	if (path->dentry != path->mnt->mnt_root)
+		return -EINVAL;
+	if (!check_mnt(mnt))
+		return -EINVAL;
+	if (mnt->mnt.mnt_flags & MNT_LOCKED) /* Check optimistically */
+		return -EINVAL;
+	if (flags & MNT_FORCE && !capable(CAP_SYS_ADMIN))
+		return -EPERM;
+	return 0;
+}
+
+int path_umount(struct path *path, int flags)
+{
+	struct mount *mnt = real_mount(path->mnt);
+	int ret;
+
+	ret = can_umount(path, flags);
+	if (!ret)
+		ret = do_umount(mnt, flags);
+
+	/* we mustn't call path_put() as that would clear mnt_expiry_mark */
+	dput(path->dentry);
+	mntput_no_expire(mnt);
+	return ret;
+}
+
 static bool is_mnt_ns_file(struct dentry *dentry)
 {
 	/* Is this a proxy for a mount namespace? */
diff --git a/include/linux/seccomp.h b/include/linux/seccomp.h
index 50c460a9..0fe69924 100644
--- a/include/linux/seccomp.h
+++ b/include/linux/seccomp.h
@@ -9,6 +9,7 @@
 #ifdef CONFIG_SECCOMP
 
 #include <linux/thread_info.h>
+#include <linux/atomic.h>
 #include <asm/seccomp.h>
 
 struct seccomp_filter;
@@ -25,6 +26,7 @@ struct seccomp_filter;
  */
 struct seccomp {
 	int mode;
+	atomic_t filter_count;
 	struct seccomp_filter *filter;
 };
 
diff --git a/security/selinux/include/objsec.h b/security/selinux/include/objsec.h
index a18686d4..19ed59ea 100644
--- a/security/selinux/include/objsec.h
+++ b/security/selinux/include/objsec.h
@@ -135,4 +135,15 @@ struct bpf_security_struct {
 
 extern unsigned int selinux_checkreqprot;
 
+static inline struct task_security_struct *selinux_cred(const struct cred *cred)
+{
+	return cred->security;
+}
+
+static inline struct inode_security_struct *selinux_inode(
+						const struct inode *inode)
+{
+	return inode->i_security;
+}
+
 #endif /* _SELINUX_OBJSEC_H_ */
