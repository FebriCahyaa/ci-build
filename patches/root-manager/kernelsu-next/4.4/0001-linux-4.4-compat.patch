diff --git a/kernel/kernel_compat.h b/kernel/kernel_compat.h
new file mode 100644
index 0000000000000000000000000000000000000000..afcaa588f37be4f949f1a08d5a1a933227c7be17
--- /dev/null
+++ b/kernel/kernel_compat.h
@@ -0,0 +1,117 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/*
+ * KernelSU-Next legacy compatibility helpers for pre-4.12 kernels.
+ *
+ * These shims are deliberately provider-local. They let the provider source
+ * consume newer helper APIs without modifying the host kernel headers.
+ */
+#ifndef __KSU_NEXT_KERNEL_44_COMPAT_H
+#define __KSU_NEXT_KERNEL_44_COMPAT_H
+
+#include <linux/version.h>
+#include <linux/module.h>
+#include <linux/fs.h>
+#include <linux/uaccess.h>
+#include <linux/slab.h>
+#include <linux/vmalloc.h>
+#include <linux/atomic.h>
+
+#if LINUX_VERSION_CODE < KERNEL_VERSION(4, 8, 0)
+static inline unsigned long ksu_next_copy_from_user_nofault(void *to,
+        const void __user *from, unsigned long count)
+{
+    unsigned long ret;
+    pagefault_disable();
+    ret = __copy_from_user(to, from, count);
+    pagefault_enable();
+    return ret;
+}
+
+static inline unsigned long ksu_next_copy_to_user_nofault(void __user *to,
+        const void *from, unsigned long count)
+{
+    unsigned long ret;
+    pagefault_disable();
+    ret = __copy_to_user(to, from, count);
+    pagefault_enable();
+    return ret;
+}
+
+static inline long ksu_next_strncpy_from_user_nofault(char *dst,
+        const char __user *src, long count)
+{
+    long ret;
+    pagefault_disable();
+    ret = strncpy_from_user(dst, src, count);
+    pagefault_enable();
+    return ret;
+}
+
+static inline long ksu_next_copy_from_kernel_nofault(void *dst,
+        const void *src, size_t size)
+{
+    return probe_kernel_read(dst, src, size);
+}
+
+static inline long ksu_next_copy_to_kernel_nofault(void *dst,
+        const void *src, size_t size)
+{
+    return probe_kernel_write(dst, src, size);
+}
+
+#ifndef copy_from_user_nofault
+#define copy_from_user_nofault ksu_next_copy_from_user_nofault
+#endif
+#ifndef copy_to_user_nofault
+#define copy_to_user_nofault ksu_next_copy_to_user_nofault
+#endif
+#ifndef strncpy_from_user_nofault
+#define strncpy_from_user_nofault ksu_next_strncpy_from_user_nofault
+#endif
+#ifndef copy_from_kernel_nofault
+#define copy_from_kernel_nofault ksu_next_copy_from_kernel_nofault
+#endif
+#ifndef copy_to_kernel_nofault
+#define copy_to_kernel_nofault ksu_next_copy_to_kernel_nofault
+#endif
+#endif /* < 4.8 */
+
+#if LINUX_VERSION_CODE < KERNEL_VERSION(4, 11, 0)
+typedef atomic_t refcount_t;
+#ifndef REFCOUNT_INIT
+#define REFCOUNT_INIT(n) ATOMIC_INIT(n)
+#endif
+#endif
+
+#if LINUX_VERSION_CODE < KERNEL_VERSION(4, 12, 0)
+extern int is_vmalloc_addr(const void *x);
+
+static inline void *ksu_next_kvmalloc(size_t size, gfp_t flags)
+{
+    void *p = kmalloc(size, flags);
+    return p ? p : vmalloc(size);
+}
+
+static inline void ksu_next_kvfree(const void *p)
+{
+    if (!p)
+        return;
+    if (is_vmalloc_addr(p))
+        vfree(p);
+    else
+        kfree(p);
+}
+
+#ifndef kvmalloc
+#define kvmalloc ksu_next_kvmalloc
+#endif
+#ifndef kvfree
+#define kvfree ksu_next_kvfree
+#endif
+#endif /* < 4.12 */
+
+#ifndef MODULE_IMPORT_NS
+#define MODULE_IMPORT_NS(ns)
+#endif
+
+#endif /* __KSU_NEXT_KERNEL_44_COMPAT_H */
