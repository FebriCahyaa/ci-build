+#else
+/*
+ * Linux 4.19 exposes the older split clone_file_range()/dedupe_file_range()
+ * callbacks instead of remap_file_range(). Keep the wrapper functional for
+ * legacy kernels without importing newer VFS fields into struct
+ * file_operations.
+ */
+static int ksu_wrapper_clone_file_range(struct file *file_in, loff_t pos_in,
+                                        struct file *file_out, loff_t pos_out,
+                                        u64 len)
+{
+    struct ksu_file_wrapper *data = file_in->private_data;
+    struct file *orig = data->orig;
+    if (!orig->f_op->clone_file_range)
+        return -EOPNOTSUPP;
+    return orig->f_op->clone_file_range(orig, pos_in, file_out, pos_out, len);
+}
+
+static int ksu_wrapper_dedupe_file_range(struct file *file_in, loff_t pos_in,
+                                         struct file *file_out, loff_t pos_out,
+                                         u64 len)
+{
+    struct ksu_file_wrapper *data = file_in->private_data;
+    struct file *orig = data->orig;
+    if (!orig->f_op->dedupe_file_range)
+        return -EOPNOTSUPP;
+    return orig->f_op->dedupe_file_range(orig, pos_in, file_out, pos_out, len);
+}
