diff --git a/kernel/kpm/compat_set_memory.h b/kernel/kpm/compat_set_memory.h
new file mode 100644
index 0000000000000000000000000000000000000000..bef6fcf7717a229f7d416b08e9d27bcbc0fd49c2
--- /dev/null
+++ b/kernel/kpm/compat_set_memory.h
@@ -0,0 +1,18 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/*
+ * KPM set_memory include compatibility for old Android kernels.
+ * Linux 4.4 arm64 exposes the set_memory_* declarations through
+ * <asm/cacheflush.h>, while newer kernels provide <linux/set_memory.h>.
+ */
+#ifndef __SUKISU_ULTRA_COMPAT_SET_MEMORY_H
+#define __SUKISU_ULTRA_COMPAT_SET_MEMORY_H
+
+#include <linux/version.h>
+
+#if LINUX_VERSION_CODE < KERNEL_VERSION(4, 19, 0)
+#include <asm/cacheflush.h>
+#else
+#include <linux/set_memory.h>
+#endif
+
+#endif /* __SUKISU_ULTRA_COMPAT_SET_MEMORY_H */
