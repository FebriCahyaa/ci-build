@@ -1,24 +1,126 @@
-#ifndef __KSU_H_KERNEL_COMPAT
-#define __KSU_H_KERNEL_COMPAT
+/* SPDX-License-Identifier: GPL-2.0-only */
+/*
+ * SukiSU Ultra legacy compatibility helpers.
+ * Keep old-kernel shims inside the provider tree rather than modifying the
+ * vendor kernel's public headers.
+ */
+#ifndef __SUKISU_ULTRA_KERNEL_COMPAT_H
+#define __SUKISU_ULTRA_KERNEL_COMPAT_H
 
-#include <linux/fs.h>
 #include <linux/version.h>
+#include <linux/module.h>
+#include <linux/fs.h>
+#include <linux/uaccess.h>
+#include <linux/slab.h>
+#include <linux/vmalloc.h>
+#include <linux/atomic.h>
 
-/*
- * ksu_copy_from_user_retry
- * try nofault copy first, if it fails, try with plain
- * paramters are the same as copy_from_user
- * 0 = success
- */
-static long ksu_copy_from_user_retry(void *to, const void __user *from,
-                                     unsigned long count)
+#if LINUX_VERSION_CODE < KERNEL_VERSION(4, 8, 0)
+static inline unsigned long suki_copy_from_user_nofault(void *to,
+        const void __user *from, unsigned long count)
+{
+    unsigned long ret;
+    pagefault_disable();
+    ret = __copy_from_user(to, from, count);
+    pagefault_enable();
+    return ret;
+}
+
+static inline unsigned long suki_copy_to_user_nofault(void __user *to,
+        const void *from, unsigned long count)
+{
+    unsigned long ret;
+    pagefault_disable();
+    ret = __copy_to_user(to, from, count);
+    pagefault_enable();
+    return ret;
+}
+
+static inline long suki_strncpy_from_user_nofault(char *dst,
+        const char __user *src, long count)
+{
+    long ret;
+    pagefault_disable();
+    ret = strncpy_from_user(dst, src, count);
+    pagefault_enable();
+    return ret;
+}
+
+static inline long suki_copy_from_kernel_nofault(void *dst,
+        const void *src, size_t size)
+{
+    return probe_kernel_read(dst, src, size);
+}
+
+static inline long suki_copy_to_kernel_nofault(void *dst,
+        const void *src, size_t size)
+{
+    return probe_kernel_write(dst, src, size);
+}
+
+#ifndef copy_from_user_nofault
+#define copy_from_user_nofault suki_copy_from_user_nofault
+#endif
+#ifndef copy_to_user_nofault
+#define copy_to_user_nofault suki_copy_to_user_nofault
+#endif
+#ifndef strncpy_from_user_nofault
+#define strncpy_from_user_nofault suki_strncpy_from_user_nofault
+#endif
+#ifndef copy_from_kernel_nofault
+#define copy_from_kernel_nofault suki_copy_from_kernel_nofault
+#endif
+#ifndef copy_to_kernel_nofault
+#define copy_to_kernel_nofault suki_copy_to_kernel_nofault
+#endif
+#endif /* < 4.8 */
+
+#if LINUX_VERSION_CODE < KERNEL_VERSION(4, 11, 0)
+typedef atomic_t refcount_t;
+#ifndef REFCOUNT_INIT
+#define REFCOUNT_INIT(n) ATOMIC_INIT(n)
+#endif
+#endif
+
+#if LINUX_VERSION_CODE < KERNEL_VERSION(4, 12, 0)
+extern int is_vmalloc_addr(const void *x);
+
+static inline void *suki_kvmalloc(size_t size, gfp_t flags)
+{
+    void *p = kmalloc(size, flags);
+    return p ? p : vmalloc(size);
+}
+
+static inline void suki_kvfree(const void *p)
+{
+    if (!p)
+        return;
+    if (is_vmalloc_addr(p))
+        vfree(p);
+    else
+        kfree(p);
+}
+
+#ifndef kvmalloc
+#define kvmalloc suki_kvmalloc
+#endif
+#ifndef kvfree
+#define kvfree suki_kvfree
+#endif
+#endif /* < 4.12 */
+
+#ifndef MODULE_IMPORT_NS
+#define MODULE_IMPORT_NS(ns)
+#endif
+
+/* Compatibility helper retained for providers which use the safe retry path. */
+static inline long ksu_copy_from_user_retry(void *to, const void __user *from,
+                                             unsigned long count)
 {
     long ret = copy_from_user_nofault(to, from, count);
     if (likely(!ret))
         return ret;
-
-    // we faulted! fallback to slow path
     return copy_from_user(to, from, count);
 }
 
-#endif
+#endif /* __SUKISU_ULTRA_KERNEL_COMPAT_H */
