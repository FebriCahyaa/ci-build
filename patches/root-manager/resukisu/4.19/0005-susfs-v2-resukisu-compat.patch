From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
Subject: [PATCH] ReSukiSU SUSFS: restore missing 4.19 compatibility API

The Lavender 4.19 tree already carries a SUSFS v2.0.0 implementation, but
its legacy susfs_def.h is missing the process-state helpers expected by the
current ReSukiSU SUSFS inline-hook path. It also lacks the deferred work item
referenced by ReSukiSU's setuid/umount hooks.

Keep the existing SUSFS implementation and add only the compatibility API
required for the ReSukiSU provider used by this 4.19 build.

---
 include/linux/susfs_def.h | 19 +++++++++++++++++++
 fs/susfs.c                | 16 ++++++++++++++++
 2 files changed, 39 insertions(+)

diff --git a/include/linux/susfs_def.h b/include/linux/susfs_def.h
--- a/include/linux/susfs_def.h
+++ b/include/linux/susfs_def.h
@@ -53,5 +53,7 @@
  * task_struct->thread_info.flags => storing flag 'TIF_'
  */
  // thread_info->flags is unsigned long :D
 #define TIF_PROC_UMOUNTED 33
+#define TIF_PROC_NO_SU 34
+#define TIF_PROC_UMOUNTED_FOR_ZYGOTE_NEXT 35
 
@@ -84,3 +84,25 @@ static inline void susfs_set_current_proc_umounted(void) {
 	set_ti_thread_flag(&current->thread_info, TIF_PROC_UMOUNTED);
 }
+
+static inline bool susfs_is_current_proc_no_su(void) {
+	return test_ti_thread_flag(&current->thread_info, TIF_PROC_NO_SU);
+}
+
+static inline void susfs_set_current_proc_no_su(void) {
+	set_ti_thread_flag(&current->thread_info, TIF_PROC_NO_SU);
+}
+
+static inline void susfs_clear_current_proc_no_su(void) {
+	clear_ti_thread_flag(&current->thread_info, TIF_PROC_NO_SU);
+}
+
+static inline bool susfs_is_current_proc_umounted_for_zygote_next(void) {
+	return test_ti_thread_flag(&current->thread_info,
+			TIF_PROC_UMOUNTED_FOR_ZYGOTE_NEXT);
+}
+
+static inline void susfs_set_current_proc_umounted_for_zygote_next(void) {
+	set_ti_thread_flag(&current->thread_info,
+			TIF_PROC_UMOUNTED_FOR_ZYGOTE_NEXT);
+}
 #endif // #ifndef KSU_SUSFS_DEF_H

diff --git a/fs/susfs.c b/fs/susfs.c
--- a/fs/susfs.c
+++ b/fs/susfs.c
@@ -17,4 +17,5 @@
 #include <linux/kthread.h>
 #include <linux/delay.h>
 #include <linux/delay.h>
+#include <linux/workqueue.h>
 #include <linux/fsnotify_backend.h>
@@ -1208,15 +1208,31 @@
 void susfs_start_sdcard_monitor_fn(void) {
 	if (IS_ERR(kthread_run(susfs_sdcard_monitor_fn, NULL, "susfs_sdcard_monitor"))) {
 		SUSFS_LOGE("failed to create thread susfs_sdcard_monitor\n");
 		SUSFS_LOGI("set susfs_is_sdcard_android_data_decrypted to true\n");
 		susfs_is_sdcard_android_data_decrypted = true;
 	}
 }
 
+/*
+ * ReSukiSU defers the SUSFS path refresh until after the setresuid/umount
+ * path has completed. The older Lavender SUSFS port did not expose the
+ * work item required by the current ReSukiSU provider.
+ */
+struct work_struct susfs_extra_works;
+
+static void susfs_run_extra_works(struct work_struct *work)
+{
+	(void)work;
+#ifdef CONFIG_KSU_SUSFS_SUS_PATH
+	susfs_run_sus_path_loop(current_uid().val);
+#endif
+}
+
 /* susfs_init */
 void susfs_init(void) {
 #ifdef CONFIG_KSU_SUSFS_SPOOF_UNAME
 	susfs_my_uname_init();
 #endif
+	INIT_WORK(&susfs_extra_works, susfs_run_extra_works);
 	SUSFS_LOGI("susfs is initialized! version: " SUSFS_VERSION " \n");
 }
