From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
Subject: [PATCH] ReSukiSU SUSFS: restore missing 4.19 compatibility symbols

The Lavender 4.19 tree already carries SUSFS v2.0.0, but its legacy
susfs_def.h is missing the process-state helpers expected by the current
ReSukiSU SUSFS inline-hook path. The provider also references the deferred
work item susfs_extra_works.

Use real visible kernel symbols instead of static-inline shims so calls from
the ReSukiSU objects remain linkable under the provider's LTO build. Keep the
existing Lavender SUSFS implementation otherwise unchanged.

---
 include/linux/susfs_def.h | 23 +++++++++++++++++++++++
 fs/susfs.c                | 42 ++++++++++++++++++++++++++++++++++++++++++
 2 files changed, 65 insertions(+)

diff --git a/include/linux/susfs_def.h b/include/linux/susfs_def.h
--- a/include/linux/susfs_def.h
+++ b/include/linux/susfs_def.h
@@ -1,6 +2,7 @@
 #define KSU_SUSFS_DEF_H
 
 #include <linux/bits.h>
+#include <linux/compiler_attributes.h>
 
 /********/
 /* ENUM */
@@ -54,5 +56,7 @@
  */
  // thread_info->flags is unsigned long :D
 #define TIF_PROC_UMOUNTED 33
+#define TIF_PROC_NO_SU 34
+#define TIF_PROC_UMOUNTED_FOR_ZYGOTE_NEXT 35
 
 #define AS_FLAGS_SUS_PATH 33
@@ -84,5 +91,12 @@
 static inline void susfs_set_current_proc_umounted(void) {
 	set_ti_thread_flag(&current->thread_info, TIF_PROC_UMOUNTED);
 }
+
+bool susfs_is_current_proc_no_su(void);
+void susfs_set_current_proc_no_su(void);
+void susfs_clear_current_proc_no_su(void);
+bool susfs_is_current_proc_umounted_for_zygote_next(void);
+void susfs_set_current_proc_umounted_for_zygote_next(void);
+
 #endif // #ifndef KSU_SUSFS_DEF_H
 
diff --git a/fs/susfs.c b/fs/susfs.c
--- a/fs/susfs.c
+++ b/fs/susfs.c
@@ -17,6 +18,7 @@
 #include <linux/kthread.h>
 #include <linux/delay.h>
 #include <linux/delay.h>
+#include <linux/workqueue.h>
 #include <linux/fsnotify_backend.h>
 #include <linux/susfs.h>
 #include "mount.h"
@@ -1208,5 +1252,49 @@
 	}
 }
 
+/*
+ * ReSukiSU 4.19 compatibility layer.
+ *
+ * These must be real global symbols instead of only static-inline helpers:
+ * under the provider's LTO build, calls from the KernelSU objects can be
+ * emitted as external references and subsequently reach MODPOST/vmlinux.
+ */
+__visible bool susfs_is_current_proc_no_su(void)
+{
+	return test_ti_thread_flag(&current->thread_info, TIF_PROC_NO_SU);
+}
+
+__visible void susfs_set_current_proc_no_su(void)
+{
+	set_ti_thread_flag(&current->thread_info, TIF_PROC_NO_SU);
+}
+
+__visible void susfs_clear_current_proc_no_su(void)
+{
+	clear_ti_thread_flag(&current->thread_info, TIF_PROC_NO_SU);
+}
+
+__visible bool susfs_is_current_proc_umounted_for_zygote_next(void)
+{
+	return test_ti_thread_flag(&current->thread_info,
+		TIF_PROC_UMOUNTED_FOR_ZYGOTE_NEXT);
+}
+
+__visible void susfs_set_current_proc_umounted_for_zygote_next(void)
+{
+	set_ti_thread_flag(&current->thread_info,
+		TIF_PROC_UMOUNTED_FOR_ZYGOTE_NEXT);
+}
+
+__visible struct work_struct susfs_extra_works;
+
+static void susfs_run_extra_works(struct work_struct *work)
+{
+	(void)work;
+#ifdef CONFIG_KSU_SUSFS_SUS_PATH
+	susfs_run_sus_path_loop(current_uid().val);
+#endif
+}
+
 /* susfs_init */
 void susfs_init(void) {
