# ReSukiSU / Linux 4.19 (SouthWest-NG): manual hooks from host-series.conf.
# The host hooks for setuid, sys_read and input are no-ops while the matching
# AUTO option is enabled, so ReSukiSU's LSM / input_handler hooks stay in charge.
CONFIG_KSU=y
CONFIG_KSU_MANUAL_HOOK=y
CONFIG_KSU_MANUAL_HOOK_AUTO_SETUID_HOOK=y
CONFIG_KSU_MANUAL_HOOK_AUTO_INITRC_HOOK=y
CONFIG_KSU_MANUAL_HOOK_AUTO_INPUT_HOOK=y
